# TylerTube Environment Configuration
# Copy this file to .env and fill in your values.

# Google OAuth 2.0 Credentials (for YouTube Subscriptions & Shorts personal feeds)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Override redirect URI (default is automatically derived from host header)
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional: Upload key for /api/upload
# TYLERTUBE_UPLOAD_KEY=
