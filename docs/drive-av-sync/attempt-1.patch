+    outOfSyncSamples: 0,
+    hardResyncTimes: [],
+    // Current out-of-sync episode (for "is catch-up making progress?")
+    episodeStartAbs: null,
+    episodeStartSkipped: 0,
+    // Last automatic hard resync (for back-off when it didn't help)
+    lastHardAt: null,
+    lastHardDirection: 0,
+    autoHardDisabled: false
+  };
+}
+
+// Re-anchor after anything that legitimately disturbs the clocks.
+export function anchorAvSync(state, now) {
+  return { ...state, anchorAt: now, outOfSyncSamples: 0, episodeStartAbs: null };
+}
+
+// Decide what to do with one drift sample.
+// sample: {
+//   drift: number|null (seconds, >0 = video ahead),
+//   active: boolean (playing, not buffering, audio clock running),
+//   framesSkipped: number (cumulative frames decoded without rendering by the scheduler)
+// }
+// Returns { action: "none" | "soft" | "hard", reason, state }.
+// "soft" = the frame scheduler is (or should be) correcting; "hard" = restart the stream.
+// Escalation rules:
+// - |drift| >= hardThreshold -> hard.
+// - persistent soft drift with video AHEAD (audio stalled / video held) -> hard.
+// - persistent soft drift with video BEHIND -> hard only if catch-up is making no
+//   progress (drift not shrinking AND no frames being skipped); a slow decoder that
+//   is skipping frames would not be helped by a restart.
+// - back-off: if a hard resync is wanted again in the same direction within
+//   backoffWindowMs of the previous one, it didn't help -> disable auto-hard for the
+//   rest of the stream (soft only; the manual "Resync A/V now" still works).
+export function evaluateAvSync(state, sample, now, cfg = AV_SYNC) {
+  const s = {
+    ...createAvSyncState(0),
+    ...state,
+    hardResyncTimes: (state.hardResyncTimes || []).filter(
+      (t) => now - t < cfg.hardWindowMs
+    )
+  };
+  const resetEpisode = () => {
+    s.outOfSyncSamples = 0;
+    s.episodeStartAbs = null;
+  };
+  if (!sample || !sample.active || !Number.isFinite(sample.drift)) {
+    resetEpisode();
+    return { action: "none", reason: "inactive", state: s };
+  }
+  if (now - s.anchorAt < cfg.graceMs) {
+    resetEpisode();
+    return { action: "none", reason: "grace", state: s };
+  }
+  const abs = Math.abs(sample.drift);
+  if (abs <= cfg.softThresholdSec) {
+    resetEpisode();
+    return { action: "none", reason: "in-sync", state: s };
+  }
+
+  const direction = sample.drift > 0 ? 1 : -1;
+  const skipped = Number.isFinite(sample.framesSkipped) ? sample.framesSkipped : 0;
+  if (s.episodeStartAbs === null) {
+    s.episodeStartAbs = abs;
+    s.episodeStartSkipped = skipped;
+  }
+  s.outOfSyncSamples += 1;
+
+  const large = abs >= cfg.hardThresholdSec;
+  let hardReason = large ? "large-drift" : null;
+  if (!large && s.outOfSyncSamples >= cfg.softPersistSamples) {
+    if (direction > 0) {
+      hardReason = "persistent-video-ahead";
+    } else {
+      const shrinking = abs < s.episodeStartAbs - cfg.minProgressSec;
+      const skipping = skipped > s.episodeStartSkipped;
+      if (shrinking || skipping) {
+        // Catch-up is working (or the device is skipping as fast as it can):
+        // a restart wouldn't help. Start a new observation window.
+        s.outOfSyncSamples = 1;
+        s.episodeStartAbs = abs;
+        s.episodeStartSkipped = skipped;
+        return { action: "soft", reason: "catching-up", state: s };
+      }
+      hardReason = "persistent-video-behind";
+    }
+  }
+  if (!hardReason) {
+    return {
+      action: "soft",
+      reason: direction > 0 ? "video-ahead" : "video-behind",
+      state: s
+    };
+  }
+
+  if (s.autoHardDisabled) {
+    return { action: "soft", reason: "auto-hard-disabled", state: s };
+  }
+  if (
+    s.lastHardAt !== null &&
+    now - s.lastHardAt < cfg.backoffWindowMs &&
+    direction === s.lastHardDirection
+  ) {
+    s.autoHardDisabled = true;
+    return { action: "soft", reason: "hard-backoff", state: s };
+  }
+  const last = s.hardResyncTimes[s.hardResyncTimes.length - 1];
+  if (last !== undefined && now - last < cfg.hardCooldownMs) {
+    return { action: "soft", reason: "hard-cooldown", state: s };
+  }
+  if (s.hardResyncTimes.length >= cfg.maxHardPerWindow) {
+    return { action: "soft", reason: "hard-limit", state: s };
+  }
+  s.hardResyncTimes = [...s.hardResyncTimes, now];
+  s.lastHardAt = now;
+  s.lastHardDirection = direction;
+  s.anchorAt = now;
+  resetEpisode();
+  return { action: "hard", reason: hardReason, state: s };
+}
+
+// Media position to restart from on a hard resync, from the audio clock at resync time.
+// heardPts must already be the *heard* audio PTS (JSMpeg's MP2 audio.currentTime is
+// decodedTime - destination.enqueuedTime); firstPts/seekBase map stream PTS to media
+// time the same way DriveVideoPlayer's onVideoDecode does. Falls back to `fallback`
+// (e.g. currentMediaTimeRef) when the audio clock isn't usable.
+export function computeResyncTarget({
+  seekBase,
+  heardPts,
+  firstPts,
+  speed,
+  duration,
+  fallback
+}) {
+  const spd = Number.isFinite(speed) && speed > 0 ? speed : 1;
+  let target;
+  if (
+    Number.isFinite(heardPts) &&
+    heardPts > 0 &&
+    Number.isFinite(firstPts) &&
+    heardPts >= firstPts
+  ) {
+    target = (Number.isFinite(seekBase) ? seekBase : 0) + (heardPts - firstPts) * spd;
+  } else {
+    target = Number.isFinite(fallback) ? fallback : 0;
+  }
+  if (Number.isFinite(duration) && duration > 0) {
+    target = Math.min(duration - 0.1, target);
+  }
+  return Math.max(0, target);
+}
