diff --git a/tests/drive-sync.test.js b/tests/drive-sync.test.js
new file mode 100644
index 0000000..ae2e818
--- /dev/null
+++ b/tests/drive-sync.test.js
@@ -0,0 +1,217 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  AV_SYNC,
+  MP2_FRAME_SAMPLES,
+  anchorAvSync,
+  computeAudiblePts,
+  computeAvDrift,
+  computeResyncTarget,
+  createAvSyncState,
+  evaluateAvSync
+} from "../src/components/drive/driveUtils.js";
+import { buildAtempoChain, buildDriveFfmpegArgs } from "../server/drive-ws.js";
+
+const FRAME = MP2_FRAME_SAMPLES / 44100;
+const close = (a, b, eps = 1e-9) => assert.ok(Math.abs(a - b) < eps, `${a} != ${b}`);
+
+test("computeAudiblePts adds one MP2 frame and subtracts queued audio", () => {
+  close(computeAudiblePts(10, 0.4, 44100), 10 + FRAME - 0.4);
+  close(computeAudiblePts(10, 0, 48000), 10 + 1152 / 48000);
+  close(computeAudiblePts(10, -1, undefined), 10 + FRAME);
+  assert.equal(computeAudiblePts(0, 0.1, 44100), null);
+  assert.equal(computeAudiblePts(NaN, 0.1, 44100), null);
+  assert.equal(computeAudiblePts(0.01, 5, 44100), 0);
+});
+
+test("computeAvDrift: positive = video ahead, includes user offset", () => {
+  const heard = 10 + FRAME - 0.4;
+  close(computeAvDrift({ videoPts: heard + 0.2, audioPts: 10, audioQueuedSec: 0.4, sampleRate: 44100 }), 0.2);
+  close(computeAvDrift({ videoPts: heard - 0.3, audioPts: 10, audioQueuedSec: 0.4 }), -0.3);
+  close(computeAvDrift({ videoPts: heard + 0.1, audioPts: 10, audioQueuedSec: 0.4, syncOffset: 0.1 }), 0);
+  assert.equal(computeAvDrift({ videoPts: 0, audioPts: 10 }), null);
+  assert.equal(computeAvDrift({ videoPts: 5, audioPts: 0 }), null);
+});
+
+test("evaluateAvSync: inactive and grace period never act", () => {
+  let s = createAvSyncState(0);
+  let r = evaluateAvSync(s, { drift: 5, active: false }, 10000);
+  assert.equal(r.action, "none");
+  assert.equal(r.reason, "inactive");
+  s = anchorAvSync(r.state, 10000);
+  r = evaluateAvSync(s, { drift: 5, active: true }, 10000 + AV_SYNC.graceMs - 1);
+  assert.equal(r.action, "none");
+  assert.equal(r.reason, "grace");
+  r = evaluateAvSync(s, { drift: null, active: true }, 99999);
+  assert.equal(r.action, "none");
+});
+
+test("evaluateAvSync: small drift is in sync, medium drift is soft", () => {
+  const s = createAvSyncState(0);
+  const now = AV_SYNC.graceMs + 1;
+  assert.equal(evaluateAvSync(s, { drift: 0.1, active: true }, now).reason, "in-sync");
+  assert.equal(evaluateAvSync(s, { drift: -0.12, active: true }, now).action, "none");
+  const ahead = evaluateAvSync(s, { drift: 0.3, active: true }, now);
+  assert.equal(ahead.action, "soft");
+  assert.equal(ahead.reason, "video-ahead");
+  assert.equal(evaluateAvSync(s, { drift: -0.3, active: true }, now).reason, "video-behind");
+});
+
+const T0 = AV_SYNC.graceMs + 1;
+const step = AV_SYNC.monitorIntervalMs;
+
+// Feed n samples; returns the last result.
+function feed(state, n, now, sampleAt) {
+  let r = { state };
+  for (let i = 0; i < n; i++) {
+    r = evaluateAvSync(r.state, sampleAt(i), now + i * step);
+  }
+  return { ...r, now: now + (n - 1) * step };
+}
+
+test("evaluateAvSync: large drift resyncs immediately", () => {
+  const r = evaluateAvSync(createAvSyncState(0), { drift: -1.5, active: true }, T0);
+  assert.equal(r.action, "hard");
+  assert.equal(r.reason, "large-drift");
+  assert.deepEqual(r.state.hardResyncTimes, [T0]);
+  assert.equal(r.state.anchorAt, T0);
+  assert.equal(r.state.lastHardDirection, -1);
+  // Right after a hard resync the grace period applies.
+  assert.equal(evaluateAvSync(r.state, { drift: 2, active: true }, T0 + 100).reason, "grace");
+});
+
+test("evaluateAvSync: persistent video-ahead drift escalates; in-sync resets the streak", () => {
+  const n = AV_SYNC.softPersistSamples;
+  let r = feed(createAvSyncState(0), n - 1, T0, () => ({ drift: 0.3, active: true }));
+  assert.equal(r.action, "soft");
+  assert.equal(r.reason, "video-ahead");
+  const ok = evaluateAvSync(r.state, { drift: 0.01, active: true }, r.now + step);
+  assert.equal(ok.state.outOfSyncSamples, 0);
+  r = evaluateAvSync(r.state, { drift: 0.3, active: true }, r.now + step);
+  assert.equal(r.action, "hard");
+  assert.equal(r.reason, "persistent-video-ahead");
+});
+
+test("evaluateAvSync: persistent video-behind stays soft while frames are being skipped", () => {
+  const n = AV_SYNC.softPersistSamples;
+  // Drift constant (slow decoder) but skip count rising -> restart wouldn't help.
+  const r = feed(createAvSyncState(0), n * 4, T0, (i) => ({
+    drift: -0.4,
+    active: true,
+    framesSkipped: i * 5
+  }));
+  assert.notEqual(r.action, "hard");
+  assert.ok(r.state.hardResyncTimes.length === 0, "no hard resync");
+  const at = evaluateAvSync(
+    feed(createAvSyncState(0), n - 1, T0, (i) => ({ drift: -0.4, active: true, framesSkipped: i })).state,
+    { drift: -0.4, active: true, framesSkipped: n },
+    T0 + n * step
+  );
+  assert.equal(at.action, "soft");
+  assert.equal(at.reason, "catching-up");
+});
+
+test("evaluateAvSync: persistent video-behind stays soft while drift is shrinking", () => {
+  const r = feed(createAvSyncState(0), AV_SYNC.softPersistSamples * 3, T0, (i) => ({
+    drift: -0.9 + i * 0.03,
+    active: true,
+    framesSkipped: 0
+  }));
+  assert.equal(r.state.hardResyncTimes.length, 0);
+});
+
+test("evaluateAvSync: persistent video-behind with no progress escalates", () => {
+  const n = AV_SYNC.softPersistSamples;
+  const r = feed(createAvSyncState(0), n, T0, () => ({
+    drift: -0.4,
+    active: true,
+    framesSkipped: 7
+  }));
+  assert.equal(r.action, "hard");
+  assert.equal(r.reason, "persistent-video-behind");
+});
+
+test("evaluateAvSync: back-off when a hard resync didn't help (same direction soon after)", () => {
+  let r = evaluateAvSync(createAvSyncState(0), { drift: 1.5, active: true }, T0);
+  assert.equal(r.action, "hard");
+  // Drift is back in the same direction right after grace -> disable auto-hard.
+  r = evaluateAvSync(r.state, { drift: 1.5, active: true }, T0 + AV_SYNC.graceMs + 1);
+  assert.equal(r.action, "soft");
+  assert.equal(r.reason, "hard-backoff");
+  assert.equal(r.state.autoHardDisabled, true);
+  // Stays soft for the rest of the stream, even much later.
+  r = evaluateAvSync(r.state, { drift: 1.5, active: true }, T0 + 10 * AV_SYNC.hardWindowMs);
+  assert.equal(r.action, "soft");
+  assert.equal(r.reason, "auto-hard-disabled");
+  // A new stream (fresh state) re-enables it.
+  assert.equal(evaluateAvSync(createAvSyncState(0), { drift: 1.5, active: true }, T0).action, "hard");
+});
+
+test("evaluateAvSync: opposite direction is not back-off, but cooldown applies", () => {
+  let r = evaluateAvSync(createAvSyncState(0), { drift: 1.5, active: true }, T0);
+  r = evaluateAvSync(r.state, { drift: -1.5, active: true }, T0 + AV_SYNC.graceMs + 1);
+  assert.equal(r.action, "soft");
+  assert.equal(r.reason, "hard-cooldown");
+  assert.equal(r.state.autoHardDisabled, false);
+});
+
+test("evaluateAvSync: hard resyncs are capped per window", () => {
+  let s = createAvSyncState(0);
+  let now = T0;
+  const gap = AV_SYNC.backoffWindowMs + 1; // far enough apart to not trigger back-off
+  for (let i = 0; i < AV_SYNC.maxHardPerWindow; i++) {
+    const r = evaluateAvSync(s, { drift: 2, active: true }, now);
+    assert.equal(r.action, "hard");
+    s = r.state;
+    now += gap;
+  }
+  let r = evaluateAvSync(s, { drift: 2, active: true }, now);
+  assert.equal(r.action, "soft");
+  assert.equal(r.reason, "hard-limit");
+  // Once old resyncs leave the window, hard is allowed again.
+  r = evaluateAvSync(r.state, { drift: 2, active: true }, now + AV_SYNC.hardWindowMs);
+  assert.equal(r.action, "hard");
+});
+
+test("computeResyncTarget maps the heard audio PTS to media time (no queue subtraction)", () => {
+  const base = { seekBase: 100, firstPts: 1.0, speed: 1, duration: 0, fallback: 50 };
+  close(computeResyncTarget({ ...base, heardPts: 11.0 }), 110);
+  close(computeResyncTarget({ ...base, heardPts: 11.0, speed: 2 }), 120);
+  close(computeResyncTarget({ ...base, heardPts: 11.0, duration: 105 }), 104.9);
+  // Unusable audio clock -> fallback.
+  close(computeResyncTarget({ ...base, heardPts: NaN }), 50);
+  close(computeResyncTarget({ ...base, heardPts: 0.5 }), 50);
+  close(computeResyncTarget({ ...base, heardPts: 11, firstPts: null }), 50);
+  close(computeResyncTarget({ heardPts: NaN }), 0);
+});
+
+test("buildAtempoChain keeps each atempo within 0.5..2", () => {
+  assert.deepEqual(buildAtempoChain(1), []);
+  assert.deepEqual(buildAtempoChain(1.005), []);
+  assert.deepEqual(buildAtempoChain(1.5), ["atempo=1.5"]);
+  assert.deepEqual(buildAtempoChain(0.5), ["atempo=0.5"]);
+  assert.deepEqual(buildAtempoChain(0.25), ["atempo=0.5", "atempo=0.5"]);
+  assert.deepEqual(buildAtempoChain(4), ["atempo=2.0", "atempo=2"]);
+  assert.deepEqual(buildAtempoChain(NaN), []);
+});
+
+test("buildDriveFfmpegArgs aligns A/V start and keeps CFR output", () => {
+  const args = buildDriveFfmpegArgs({ input: "/v/a.mp4", seek: 12.5, speed: 1, quality: 480 });
+  const at = (flag) => args[args.indexOf(flag) + 1];
+  assert.equal(at("-ss"), "12.500");
+  assert.ok(args.indexOf("-ss") < args.indexOf("-i"), "-ss must be an input option");
+  assert.equal(at("-i"), "/v/a.mp4");
+  assert.equal(at("-vf"), "fps=fps=30:start_time=0,scale=854:480");
+  assert.equal(args.indexOf("-fps_mode"), -1, "no -fps_mode (needs ffmpeg >= 5.1)");
+  assert.equal(at("-af"), "aresample=44100:async=1000:first_pts=0");
+  assert.equal(at("-b:v"), "900k");
+  assert.equal(args[args.length - 1], "-");
+
+  const fast = buildDriveFfmpegArgs({ input: "x", seek: 0, speed: 1.5, quality: 1080 });
+  const fat = (flag) => fast[fast.indexOf(flag) + 1];
+  assert.equal(fast.indexOf("-ss"), -1);
+  assert.equal(fat("-vf"), "setpts=PTS/1.5,fps=fps=30:start_time=0,scale=1920:1080");
+  // Resample/align before atempo so both tracks scale from the same origin.
+  assert.equal(fat("-af"), "aresample=44100:async=1000:first_pts=0,atempo=1.5");
+  assert.equal(fat("-b:v"), "2600k");
+});
