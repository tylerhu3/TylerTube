<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TylerTube standalone Drive server (server/standalone.js) as a per-user LaunchAgent.
  Install:  cp scripts/launchd/com.tylertube.drive.plist ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tylertube.drive.plist
  Restart:  launchctl kickstart -k gui/$(id -u)/com.tylertube.drive
  Remove:   launchctl bootout gui/$(id -u)/com.tylertube.drive
  Logs:     /tmp/tylertube-drive.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tylertube.drive</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/Shared/MyStreamingApp/server/standalone.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Shared/MyStreamingApp</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd's default PATH lacks Homebrew; drive-ws.js spawns ffmpeg/ffprobe by name. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>DRIVE_PORT</key>
        <string>5180</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/tylertube-drive.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tylertube-drive.log</string>
</dict>
</plist>
